# Rasters, point clouds, and other large binaries
*.tif
*.tiff
*.laz
*.las
*.vrt
*.zip
*.nc
*.jp2
*.npy
*.npz
*.pt
*.pkl
*.gpkg
*.shp
*.csv
*.u16
# Small derived place-relief fallback meshes. Source rasters stay ignored.
!Anatolia/atlas/public/terrain/details/*/copernicus/height.u16

# Inventory dumps stay out of git. The atlas's published site files are the exception.
*.geojson
!Anatolia/atlas/public/sites.geojson
!Anatolia/explorer/public/sites.geojson
!Anatolia/atlas/public/wikidata/sites.geojson

# Bulk JSON dumps. data/ is already ignored; this catches copies left elsewhere.
*.json.gz

# Local data and generated products
data/
outputs/

# Precise candidate locations. Do not commit these (looting risk).
candidates_private*

# Local settings. The two account settings are public values, but no env file belongs in git (docs/accounts.md).
.env*

# Node
node_modules/
.next/
# Check builds beside a running dev server (docs/deploy.md).
Anatolia/atlas/.next-*/
*.tsbuildinfo
Anatolia/explorer/screenshots/
Anatolia/atlas/public/terrain/regions/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
dist/
*.egg-info/
.mypy_cache/
.ruff_cache/

# Gaussian splats. Training files and trials stay local. The published splats and their
# credits are committed: see Anatolia/atlas/public/splats/README.md for their licence.
*.ply
*.splat
!Anatolia/atlas/public/splats/*.splat

# GPU tuning cache written by the Brush splat trainer.
target/
