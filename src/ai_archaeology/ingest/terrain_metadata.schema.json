{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-archaeology.local/terrain-metadata.schema.json",
  "title": "Standardised terrain raster metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "licence",
    "attribution",
    "acquisition_date",
    "native_resolution_m",
    "target_resolution_m",
    "vertical_datum",
    "vertical_unit",
    "crs",
    "nodata",
    "bare_earth",
    "checksum_sha256",
    "processing_steps",
    "adapter",
    "source_url",
    "created_at",
    "library_versions"
  ],
  "properties": {
    "source": {"type": "string", "minLength": 1},
    "licence": {"type": "string", "minLength": 1},
    "attribution": {"type": "string", "minLength": 1},
    "acquisition_date": {"type": ["string", "null"]},
    "native_resolution_m": {"type": "number", "exclusiveMinimum": 0},
    "target_resolution_m": {"type": "number", "exclusiveMinimum": 0},
    "vertical_datum": {"type": "string", "minLength": 1},
    "vertical_unit": {"const": "metres"},
    "crs": {"type": "string", "pattern": "^EPSG:[0-9]+$"},
    "nodata": {"type": "number"},
    "bare_earth": {"type": "boolean"},
    "checksum_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "adapter": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "library_versions": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "processing_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "parameters"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "parameters": {"type": "object"}
        }
      }
    }
  }
}
